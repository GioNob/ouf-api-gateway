  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["contract", "limitPerIntent", "intents"],
    "properties": {
      "contract": {"type": "string", "const": "ouf.semantic.published-batch.v1"},
      "limitPerIntent": {"type": "integer", "minimum": 1, "maximum": 8},
      "intents": {
        "type": "array", "minItems": 1, "maxItems": 64,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["intentId", "intent", "preferredLanguages", "requestedArtifactType", "context"],
          "properties": {
            "intentId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
            "intent": {"type": "string", "minLength": 1, "maxLength": 256},
            "preferredLanguages": {
              "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8}){0,3}$"}
            },
            "requestedArtifactType": {"type": "string", "enum": ["PROPERTY", "CLASS", "DATATYPE"]},
            "context": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "namespace": {"type": "string", "minLength": 1, "maxLength": 512},
                "domain": {"type": "string", "minLength": 1, "maxLength": 2048},
                "range": {"type": "string", "minLength": 1, "maxLength": 2048}
              }
            }
          }
        }
      }
    }
