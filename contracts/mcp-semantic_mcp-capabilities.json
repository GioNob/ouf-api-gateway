  "capabilities": [
    {
      "toolName": "semantic.review.prepare",
      "nextPolicy": "validation",
      "capabilityId": "ouf.semantic.review.prepare",
      "purpose": "Validate the exact DRAFT row version and retain errors and warnings",
      "useWhen": [
        "preparing authorized native semantic proposals for human review"
      ],
      "doNotUseWhen": [
        "approving, publishing, activating, adopting external terms or bypassing owner decisions"
      ],
      "preferredAlternatives": [
        "Trusted Human Surface"
      ],
      "operationalLimits": {
        "maxArtifacts": 1,
        "maxRequestBytes": 65536,
        "profile": "ouf.semantic-proposal-channel.v1"
      },
      "resultSemantics": "Owner receipt only; a review reference is not human approval or publication. Read current challenge in the THS before decision.",
      "securityNotes": [
        "Current owner authorization and Gateway signed delegation are required",
        "Stable commandKey is mandatory for mutation; ambiguous effects require receipt reconciliation",
        "Owner and authority references are proposal values, not grants"
      ],
      "mcpClass": "MCP_PROPOSAL_ONLY",
      "owner": "semantic",
      "operationClass": "COMMAND",
      "publicationState": "ACTIVE",
      "requiredAuthorizationCapability": "ouf.semantic.review.prepare",
      "gatewayBindingRef": "capability://ouf.semantic.review.prepare",
      "baseCostEnvelope": {
        "hardMaxToolCalls": 1,
        "hardMaxGraphCalls": 0,
        "hardMaxDistinctObjects": 1,
        "hardMaxResultBytes": 262144,
        "hardMaxElapsedMs": 3000
      },
      "conditionalOutcomeCost": {
        "mismatchCalls": 0,
        "equivalentRetryCalls": 1
      },
      "toolEligible": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revisionId",
          "expectedRowVersion",
          "commandKey"
        ],
        "properties": {
          "analysisId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Optional MCP analysis context, consumed locally."
          },
          "revisionId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedRowVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "commandKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_:.-]{1,128}$"
          }
        }
      }
    },
