{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "ouf.trieste.it/v1"}, "kind": {"const": "ExtractionRuntimeProfile"},
    "metadata": {"type": "object", "additionalProperties": false, "required": ["id", "version", "status"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "status": {"const": "ACTIVE"}}},
    "spec": {"type": "object", "additionalProperties": false, "required": ["sourceRef", "mode", "fieldProjection", "paging", "incrementalStrategy"], "properties": {
      "sourceRef": {"type": "string"}, "mode": {"enum": ["PULL", "MANAGED"]},
      "fieldProjection": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"}},
      "paging": {"type": "object", "additionalProperties": false, "required": ["pageSize"], "properties": {"pageSize": {"type": "integer", "minimum": 1, "maximum": 10000}}},
      "incrementalStrategy": {"enum": ["FULL_SNAPSHOT", "CHANGE_TOKEN", "LAST_MODIFIED", "MONOTONIC_ID", "SNAPSHOT_DIFF"]}
    }}
  }
}
