{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshotHash",
    "choices"
  ],
  "properties": {
    "snapshotHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issueId",
          "expectedVersion",
          "action"
        ],
        "properties": {
          "issueId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          },
          "action": {
            "type": "string",
            "enum": [
              "APPROVE",
              "CREATE_NEW",
              "DISMISS"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "targetUrbanObjectId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "expectedReviewHash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
