{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "GatewayBindingRef",
    "CapabilityID",
    "Owner",
    "OperationClass",
    "Arguments",
    "Identity",
    "AuthorizationDecisionRef",
    "CorrelationID",
    "IdempotencyKey",
    "AttemptID",
    "RequestHash",
    "MaxResultBytes"
  ],
  "properties": {
    "GatewayBindingRef": {
      "const": "capability://ouf.managed-source.onboarding.review.prepare"
    },
    "CapabilityID": {
      "const": "ouf.managed-source.onboarding.review.prepare"
    },
    "Owner": {
      "const": "onboarding"
    },
    "OperationClass": {
      "const": "COMMAND"
    },
    "Arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "onboardingVersionId",
        "expectedVersion",
        "commandKey"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
        },
        "onboardingVersionId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "commandKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "executionProposal": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:ouf:managed-file-execution-proposal:lexical-csv:v1",
          "description": "Preparation only. CSV cells stay lexical strings; property/access/source/tenant and exact semantic-reference consistency are checked against owner records. No approval, publication, compatibility attestation or runtime authority is issued.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semanticBindings",
            "semanticPublicationSetRef",
            "udp",
            "limits"
          ],
          "properties": {
            "semanticBindings": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "semanticId",
                  "semanticVersion",
                  "revisionId",
                  "publicationSetId"
                ],
                "properties": {
                  "semanticId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "^[^@\\s]+$"
                  },
                  "semanticVersion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "^[^@\\s]+$"
                  },
                  "revisionId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "publicationSetId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  }
                }
              }
            },
            "semanticPublicationSetRef": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "udp": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "resolution",
                "materialization"
              ],
              "properties": {
                "resolution": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "strategyId",
                    "strategyVersion",
                    "policyRef",
                    "governedIdentity"
                  ],
                  "properties": {
                    "strategyId": {
                      "const": "GOVERNED_IDENTITY"
                    },
                    "strategyVersion": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    },
                    "policyRef": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    },
                    "governedIdentity": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "ref",
                        "version",
                        "tenantId",
                        "canonicalClass",
                        "sourceId",
                        "maxCandidates",
                        "allowAutoNew",
                        "signals",
                        "sufficientRules"
                      ],
                      "properties": {
                        "ref": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048
                        },
                        "version": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048
                        },
                        "tenantId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048
                        },
                        "canonicalClass": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048
                        },
                        "sourceId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048
                        },
                        "maxCandidates": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1000
                        },
                        "allowAutoNew": {
                          "type": "boolean"
                        },
                        "signals": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 32,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "id",
                              "semanticRef",
                              "comparator",
                              "excludesOnDisagreement",
                              "uniqueWithinScope",
                              "assertionRef"
                            ],
                            "properties": {
                              "id": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 2048
                              },
                              "semanticRef": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 2048
                              },
                              "comparator": {
                                "type": "string",
                                "enum": [
                                  "CONCEPT",
                                  "TEXT_V1",
                                  "DECIMAL_V1",
                                  "JSON_V1"
                                ]
                              },
                              "excludesOnDisagreement": {
                                "const": false
                              },
                              "uniqueWithinScope": {
                                "const": false
                              },
                              "assertionRef": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 2048
                              }
                            }
                          }
                        },
                        "sufficientRules": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 32,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "id",
                              "signalIds",
                              "assertionRef"
                            ],
                            "properties": {
                              "id": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 2048
                              },
                              "signalIds": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 32,
                                "items": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 2048
                                },
                                "uniqueItems": true
                              },
                              "assertionRef": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 2048
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "materialization": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "policyRef",
                    "properties",
                    "bitemporalProperties",
                    "checkpointInterval"
                  ],
                  "properties": {
                    "policyRef": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    },
                    "properties": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 32,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "sourceField",
                          "propertyIri",
                          "datatype",
                          "accessLabel",
                          "authorityOrder"
                        ],
                        "properties": {
                          "sourceField": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2048
                          },
                          "propertyIri": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2048
                          },
                          "datatype": {
                            "const": "http://www.w3.org/2001/XMLSchema#string"
                          },
                          "accessLabel": {
                            "type": "string",
                            "enum": [
                              "OPEN",
                              "ANONYMOUS",
                              "PERSONAL",
                              "SENSITIVE",
                              "RESTRICTED"
                            ]
                          },
                          "authorityOrder": {
                            "type": "array",
                            "minItems": 0,
                            "maxItems": 32,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 2048
                            },
                            "uniqueItems": true
                          }
                        }
                      }
                    },
                    "bitemporalProperties": {
                      "type": "array",
                      "minItems": 0,
                      "maxItems": 0,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                      }
                    },
                    "checkpointInterval": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000000
                    }
                  }
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "maxRows",
                "maxColumns",
                "maxCellChars"
              ],
              "properties": {
                "maxRows": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "maxColumns": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "maxCellChars": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                }
              }
            }
          }
        }
      }
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ServicePrincipalID",
        "PrincipalID",
        "TenantID",
        "ActorType",
        "AuthenticationContextRef"
      ],
      "properties": {
        "ServicePrincipalID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        },
        "PrincipalID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        },
        "TenantID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        },
        "ActorType": {
          "enum": [
            "HUMAN"
          ]
        },
        "AuthenticationContextRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        }
      }
    },
    "AuthorizationDecisionRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[ -~]+$"
    },
    "CorrelationID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[ -~]+$"
    },
    "IdempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "AttemptID": {
      "type": "string",
      "format": "uuid"
    },
    "RequestHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "MaxResultBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    }
  }
}
