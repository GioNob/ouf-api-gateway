{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["GatewayBindingRef", "CapabilityID", "Owner", "OperationClass", "Arguments", "Identity", "AuthorizationDecisionRef", "CorrelationID", "IdempotencyKey", "AttemptID", "RequestHash", "MaxResultBytes"],
  "properties": {
    "GatewayBindingRef": {"type": "string", "pattern": "^capability://[a-z0-9._-]+$"},
    "CapabilityID": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
    "Owner": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
    "OperationClass": {"enum": ["READ", "SEARCH", "STATUS", "COMMAND"]},
    "Arguments": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["anchorObjectId", "anchorTypeCode", "relationIri", "direction", "targetTypeCodes", "limit"], "properties": {"anchorObjectId": {"type": "string", "format": "uuid"}, "anchorTypeCode": {"type": "string"}, "relationIri": {"type": "string"}, "direction": {"enum": ["OUTBOUND", "INBOUND"]}, "targetTypeCodes": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string"}}, "limit": {"type": "integer", "minimum": 1, "maximum": 200}, "applicationSessionRef": {"type": "string"}}},
      {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^%*]+$"}, "pageSize": {"type": "integer", "minimum": 1, "maximum": 100}, "cursor": {"type": "string", "minLength": 1, "maxLength": 128}}}
    ]},
    "Identity": {"type": "object", "additionalProperties": false, "required": ["ServicePrincipalID", "PrincipalID", "TenantID", "ActorType", "AuthenticationContextRef"], "properties": {"ServicePrincipalID": {"type": "string", "minLength": 1}, "PrincipalID": {"type": "string", "minLength": 1}, "TenantID": {"type": "string", "minLength": 1}, "ActorType": {"enum": ["HUMAN", "HUMAN_USER", "AI_AGENT", "MCP_SERVER", "SERVICE_IDENTITY"]}, "AuthenticationContextRef": {"type": "string", "minLength": 1}}},
    "AuthorizationDecisionRef": {"type": "string", "minLength": 1}, "CorrelationID": {"type": "string", "minLength": 1}, "IdempotencyKey": {"type": "string", "minLength": 1}, "AttemptID": {"type": "string", "format": "uuid"}, "RequestHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "MaxResultBytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
  }
}
