{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "GatewayBindingRef",
    "CapabilityID",
    "Owner",
    "OperationClass",
    "Arguments",
    "Identity",
    "AuthorizationDecisionRef",
    "CorrelationID",
    "IdempotencyKey",
    "AttemptID",
    "RequestHash",
    "MaxResultBytes"
  ],
  "properties": {
    "GatewayBindingRef": {
      "const": "capability://ouf.semantic.propose"
    },
    "CapabilityID": {
      "const": "ouf.semantic.propose"
    },
    "Owner": {
      "const": "semantic"
    },
    "OperationClass": {
      "const": "COMMAND"
    },
    "Arguments": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposalKey",
        "commands"
      ],
      "properties": {
        "proposalKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "minLength": 1,
          "maxLength": 128
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 21,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "semanticId",
              "artifactType",
              "namespace",
              "localName",
              "ownerRef",
              "authorityRef",
              "semanticVersion",
              "labels",
              "definition"
            ],
            "properties": {
              "semanticId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "namespace": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "localName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "ownerRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "authorityRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "semanticVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "artifactType": {
                "type": "string",
                "enum": [
                  "CLASS",
                  "PROPERTY",
                  "RELATIONSHIP",
                  "VOCABULARY",
                  "CONCEPT",
                  "ONTOLOGY"
                ]
              },
              "labels": {
                "type": "object",
                "maxProperties": 20,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "definition": {
                "type": "object",
                "maxProperties": 32
              }
            }
          }
        }
      }
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ServicePrincipalID",
        "PrincipalID",
        "TenantID",
        "ActorType",
        "AuthenticationContextRef"
      ],
      "properties": {
        "ServicePrincipalID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        },
        "PrincipalID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        },
        "TenantID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        },
        "ActorType": {
          "enum": [
            "HUMAN"
          ]
        },
        "AuthenticationContextRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        }
      }
    },
    "AuthorizationDecisionRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[ -~]+$"
    },
    "CorrelationID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[ -~]+$"
    },
    "IdempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[ -~]+$"
    },
    "AttemptID": {
      "type": "string",
      "format": "uuid"
    },
    "RequestHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "MaxResultBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144
    }
  }
}
