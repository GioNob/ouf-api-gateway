{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "GatewayBindingRef",
        "CapabilityID",
        "Owner",
        "OperationClass",
        "Arguments",
        "Identity",
        "AuthorizationDecisionRef",
        "CorrelationID",
        "IdempotencyKey",
        "AttemptID",
        "RequestHash",
        "MaxResultBytes"
      ],
      "properties": {
        "GatewayBindingRef": {
          "const": "capability://ouf.semantic.propose"
        },
        "CapabilityID": {
          "const": "ouf.semantic.propose"
        },
        "Owner": {
          "const": "semantic"
        },
        "OperationClass": {
          "const": "COMMAND"
        },
        "Arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semanticId",
            "artifactType",
            "namespace",
            "localName",
            "ownerRef",
            "authorityRef",
            "semanticVersion",
            "labels",
            "commandKey"
          ],
          "properties": {
            "semanticId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "artifactType": {
              "enum": [
                "CLASS",
                "PROPERTY",
                "RELATIONSHIP",
                "VOCABULARY",
                "CONCEPT",
                "ONTOLOGY",
                "DATATYPE",
                "VALUE_MAP"
              ]
            },
            "namespace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "localName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "ownerRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "authorityRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "semanticVersion": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?(?:\\+[A-Za-z0-9.-]+)?$"
            },
            "labels": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "it": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "de": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "sl": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "maxProperties": 4
            },
            "definition": {
              "type": "object",
              "anyOf": [
                {
                  "$ref": "#/properties/Arguments/$defs/valueMapDefinition"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "components": {
                      "$ref": "#/properties/Arguments/$defs/datatypeComponents"
                    },
                    "description": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "it": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4000
                        },
                        "en": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4000
                        },
                        "de": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4000
                        },
                        "sl": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4000
                        }
                      },
                      "maxProperties": 4
                    },
                    "domainRefs": {
                      "type": "array",
                      "maxItems": 32,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      }
                    },
                    "rangeRefs": {
                      "type": "array",
                      "maxItems": 32,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      }
                    },
                    "datatype": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "minCardinality": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "maxCardinality": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "vocabularyRef": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "inverseRef": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  }
                }
              ]
            },
            "commandKey": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_:.-]{1,128}$"
            },
            "rdfTurtle": {
              "type": "string",
              "minLength": 1,
              "maxLength": 49152
            },
            "mediaType": {
              "type": "string",
              "const": "text/turtle"
            }
          },
          "$defs": {
            "datatypeComponents": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][A-Za-z0-9]{0,63}$"
                  },
                  "type": {
                    "oneOf": [
                      {
                        "enum": [
                          "string",
                          "integer",
                          "decimal",
                          "boolean",
                          "date",
                          "datetime",
                          "geometry",
                          "concept"
                        ]
                      },
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s@]+@[A-Fa-f0-9]{8}(-[A-Fa-f0-9]{4}){3}-[A-Fa-f0-9]{12}$",
                        "maxLength": 1024
                      }
                    ]
                  },
                  "cardinality": {
                    "enum": [
                      "ONE",
                      "MANY"
                    ]
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "labels": {
                    "$ref": "#/properties/Arguments/properties/labels"
                  },
                  "constraints": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "minInclusive": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "maxInclusive": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "maxLength": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "vocabularyRef": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024,
                        "format": "iri",
                        "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:([^\\s\\x00-\\x1F\\x7F<>\\\"{}`|\\\\^%]|%[A-Fa-f0-9]{2})+$"
                      }
                    }
                  }
                },
                "required": [
                  "name",
                  "type",
                  "cardinality",
                  "required"
                ],
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "enum": [
                            "string"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "constraints": {
                          "properties": {
                            "maxLength": {}
                          },
                          "additionalProperties": false
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "enum": [
                            "concept"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "constraints": {
                          "properties": {
                            "vocabularyRef": {}
                          },
                          "additionalProperties": false
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "enum": [
                            "integer"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "constraints": {
                          "properties": {
                            "minInclusive": {
                              "pattern": "^(0|-?[1-9][0-9]*)$"
                            },
                            "maxInclusive": {
                              "pattern": "^(0|-?[1-9][0-9]*)$"
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "enum": [
                            "decimal"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "constraints": {
                          "properties": {
                            "minInclusive": {
                              "pattern": "^(0|-?[1-9][0-9]*|-?(0|[1-9][0-9]*)\\.[0-9]*[1-9])$"
                            },
                            "maxInclusive": {
                              "pattern": "^(0|-?[1-9][0-9]*|-?(0|[1-9][0-9]*)\\.[0-9]*[1-9])$"
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "enum": [
                            "date"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "constraints": {
                          "properties": {
                            "minInclusive": {
                              "format": "date",
                              "pattern": "^([0-9]{4}-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[048]|[2468][048]|[13579][26])00)-02-29)$"
                            },
                            "maxInclusive": {
                              "format": "date",
                              "pattern": "^([0-9]{4}-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[048]|[2468][048]|[13579][26])00)-02-29)$"
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "enum": [
                            "datetime"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "constraints": {
                          "properties": {
                            "minInclusive": {
                              "format": "date-time",
                              "pattern": "^([0-9]{4}-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[048]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
                            },
                            "maxInclusive": {
                              "format": "date-time",
                              "pattern": "^([0-9]{4}-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[048]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s@]+@[A-Fa-f0-9]{8}(-[A-Fa-f0-9]{4}){3}-[A-Fa-f0-9]{12}$"
                            },
                            {
                              "enum": [
                                "boolean",
                                "geometry"
                              ]
                            }
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "constraints": {
                          "maxProperties": 0
                        }
                      }
                    }
                  }
                ]
              },
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "description": "Use unique component names. The Semantic Registry resolves published pins and checks cycles, depth (4) and total leaf components (256)."
            },
            "valueMapIri": {
              "type": "string",
              "format": "iri",
              "not": {
                "pattern": "[\\x00-\\x1F\\x7F]|(?: |\u0085|\u00a0|\u1680|\u2000|\u2001|\u2002|\u2003|\u2004|\u2005|\u2006|\u2007|\u2008|\u2009|\u200a|\u2028|\u2029|\u202f|\u205f|\u3000)"
              },
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:([^\\s\\x00-\\x1F\\x7F<>\\\"{}`|\\\\^%]|%[A-Fa-f0-9]{2})+$"
            },
            "valueMapDefinition": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "targetVocabulary": {
                  "type": "string",
                  "not": {
                    "pattern": "[\\x00-\\x1F\\x7F]|(?: |\u0085|\u00a0|\u1680|\u2000|\u2001|\u2002|\u2003|\u2004|\u2005|\u2006|\u2007|\u2008|\u2009|\u200a|\u2028|\u2029|\u202f|\u205f|\u3000)"
                  },
                  "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:([^\\s\\x00-\\x1F\\x7F<>\\\"{}`|\\\\^%]|%[A-Fa-f0-9]{2})+@[A-Fa-f0-9]{8}(-[A-Fa-f0-9]{4}){3}-[A-Fa-f0-9]{12}$"
                },
                "entries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "code": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "not": {
                          "pattern": "[\\x00-\\x1F\\x7F]|^(?: |\u0085|\u00a0|\u1680|\u2000|\u2001|\u2002|\u2003|\u2004|\u2005|\u2006|\u2007|\u2008|\u2009|\u200a|\u2028|\u2029|\u202f|\u205f|\u3000)|(?: |\u0085|\u00a0|\u1680|\u2000|\u2001|\u2002|\u2003|\u2004|\u2005|\u2006|\u2007|\u2008|\u2009|\u200a|\u2028|\u2029|\u202f|\u205f|\u3000)$"
                        }
                      },
                      "concept": {
                        "$ref": "#/properties/Arguments/$defs/valueMapIri"
                      }
                    },
                    "required": [
                      "code",
                      "concept"
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 2000,
                  "description": "Codes must be unique and are case sensitive. Concepts may repeat."
                },
                "labels": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "it": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    }
                  }
                }
              },
              "required": [
                "targetVocabulary",
                "entries"
              ]
            }
          },
          "if": {
            "properties": {
              "artifactType": {
                "const": "DATATYPE"
              }
            }
          },
          "then": {
            "required": [
              "definition"
            ],
            "properties": {
              "semanticId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
              },
              "definition": {
                "required": [
                  "components"
                ],
                "properties": {
                  "description": {},
                  "components": {}
                },
                "additionalProperties": false
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "artifactType": {
                  "const": "VALUE_MAP"
                }
              }
            },
            "then": {
              "properties": {
                "semanticId": {
                  "$ref": "#/properties/Arguments/$defs/valueMapIri"
                },
                "definition": {
                  "required": [
                    "entries"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "definition": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "components"
                        ]
                      },
                      {
                        "required": [
                          "entries"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          "oneOf": [
            {
              "required": [
                "definition"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "rdfTurtle"
                    ]
                  },
                  {
                    "required": [
                      "mediaType"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "rdfTurtle",
                "mediaType"
              ],
              "properties": {
                "artifactType": {
                  "const": "ONTOLOGY"
                },
                "definition": {
                  "type": "object",
                  "maxProperties": 0
                }
              }
            }
          ]
        },
        "Identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ServicePrincipalID",
            "PrincipalID",
            "TenantID",
            "ActorType",
            "AuthenticationContextRef"
          ],
          "properties": {
            "ServicePrincipalID": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[ -~]+$"
            },
            "PrincipalID": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[ -~]+$"
            },
            "TenantID": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[ -~]+$"
            },
            "ActorType": {
              "enum": [
                "HUMAN",
                "AI_AGENT",
                "SERVICE"
              ]
            },
            "AuthenticationContextRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[ -~]+$"
            }
          }
        },
        "AuthorizationDecisionRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[ -~]+$"
        },
        "CorrelationID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[ -~]+$"
        },
        "IdempotencyKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_:.-]{1,128}$"
        },
        "AttemptID": {
          "type": "string",
          "format": "uuid"
        },
        "RequestHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "MaxResultBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      },
      "$id": "urn:ouf:gateway:dispatch:semantic.propose"
    },
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "GatewayBindingRef",
        "CapabilityID",
        "Owner",
        "OperationClass",
        "Arguments",
        "Identity",
        "AuthorizationDecisionRef",
        "CorrelationID",
        "IdempotencyKey",
        "AttemptID",
        "RequestHash",
        "MaxResultBytes"
      ],
      "properties": {
