        },
        "MaxResultBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    },
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "GatewayBindingRef",
        "CapabilityID",
        "Owner",
        "OperationClass",
        "Arguments",
        "Identity",
        "AuthorizationDecisionRef",
        "CorrelationID",
        "IdempotencyKey",
        "AttemptID",
        "RequestHash",
        "MaxResultBytes"
      ],
      "properties": {
        "GatewayBindingRef": {
          "const": "capability://ouf.semantic.approval.request"
        },
        "CapabilityID": {
          "const": "ouf.semantic.approval.request"
        },
        "Owner": {
          "const": "semantic"
        },
        "OperationClass": {
          "const": "COMMAND"
        },
        "Arguments": {
