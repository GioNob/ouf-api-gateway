{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["BackendRequestID", "Kind", "TerminalState", "OutcomeCode", "ActualDistinctObjects", "ObjectHashes"],
  "properties": {
    "BackendOwner": {"type": "string", "minLength": 1, "maxLength": 128},
    "BackendRequestID": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$"},
    "Kind": {"enum": ["OWNER_RESULT", "OWNER_PROVES_NO_DISPATCH"]},
    "TerminalState": {"enum": ["SUCCEEDED", "FAILED"]},
    "OutcomeCode": {"type": "string", "minLength": 1, "maxLength": 128},
    "ResultRef": {"type": "string", "maxLength": 512},
    "ActualDistinctObjects": {"type": "integer", "minimum": 0},
    "ObjectHashes": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"type": "string", "pattern": "^v[0-9]+:(hmac-sha256|hmac-sha384):[A-Za-z0-9_-]{32,512}$"}}
  }
}
