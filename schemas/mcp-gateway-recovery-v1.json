{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["BackendRequestID", "Owner", "CapabilityID", "CorrelationID"],
  "properties": {
    "BackendRequestID": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "Owner": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "CapabilityID": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
    "CorrelationID": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"}
  }
}
