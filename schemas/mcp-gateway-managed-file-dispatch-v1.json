{
  "oneOf": [
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "GatewayBindingRef",
        "CapabilityID",
        "Owner",
        "OperationClass",
        "Arguments",
        "Identity",
        "AuthorizationDecisionRef",
        "CorrelationID",
        "IdempotencyKey",
        "AttemptID",
        "RequestHash",
        "MaxResultBytes"
      ],
      "properties": {
        "GatewayBindingRef": {
          "const": "capability://ouf.managed-source.file.profile"
        },
        "CapabilityID": {
          "const": "ouf.managed-source.file.profile"
        },
        "Owner": {
          "const": "onboarding"
        },
        "OperationClass": {
          "const": "COMMAND"
        },
        "Arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assetId"
          ],
          "properties": {
            "assetId": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "Identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ServicePrincipalID",
            "PrincipalID",
            "TenantID",
            "ActorType",
            "AuthenticationContextRef"
          ],
          "properties": {
            "ServicePrincipalID": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[ -~]+$"
            },
            "PrincipalID": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[ -~]+$"
            },
            "TenantID": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[ -~]+$"
            },
            "ActorType": {
              "enum": [
                "HUMAN"
              ]
            },
            "AuthenticationContextRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[ -~]+$"
            }
          }
        },
        "AuthorizationDecisionRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[ -~]+$"
        },
        "CorrelationID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[ -~]+$"
        },
        "IdempotencyKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "AttemptID": {
          "type": "string",
          "format": "uuid"
        },
        "RequestHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "MaxResultBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    },
