      ],
      "properties": {
        "GatewayBindingRef": {
          "const": "capability://ouf.managed-source.onboarding.create"
        },
        "CapabilityID": {
          "const": "ouf.managed-source.onboarding.create"
        },
        "Owner": {
          "const": "onboarding"
        },
        "OperationClass": {
          "const": "COMMAND"
        },
        "Arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assetId",
            "profileId",
            "sourceId",
            "name",
            "owner",
            "targetClassIri",
            "semanticRefs"
          ],
          "properties": {
            "assetId": {
              "type": "string",
              "format": "uuid"
            },
            "profileId": {
              "type": "string",
              "format": "uuid"
            },
            "sourceId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "owner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "targetClassIri": {
              "type": "string",
              "format": "uri",
              "maxLength": 512
            },
            "semanticRefs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[^\\s@]+@[^\\s@]+$",
                "maxLength": 512
              }
            },
            "sourceObjectKeyFields": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "layer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "fields": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fieldName",
                  "extractionDecision",
                  "dataAccessLabel"
                ],
                "properties": {
                  "fieldName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "extractionDecision": {
                    "enum": [
                      "INCLUDE",
                      "EXCLUDE"
                    ]
                  },
                  "dataAccessLabel": {
                    "enum": [
                      "OPEN",
                      "ANONYMOUS",
                      "PERSONAL",
                      "SENSITIVE",
                      "RESTRICTED"
                    ]
                  },
                  "targetPropertyIri": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 512
                  },
                  "transform": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "vocabularyId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "vocabularyVersion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "valueMapRef": {
                    "type": "string",
                    "maxLength": 512
                  }
                }
              }
            }
          }
        },
        "Identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
