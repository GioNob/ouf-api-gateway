{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "GatewayBindingRef",
    "CapabilityID",
    "Owner",
    "OperationClass",
    "Arguments",
    "Identity",
    "AuthorizationDecisionRef",
    "CorrelationID",
    "IdempotencyKey",
    "AttemptID",
    "RequestHash",
    "MaxResultBytes"
  ],
  "properties": {
    "GatewayBindingRef": {
      "type": "string",
      "enum": [
        "capability://ouf.system.status"
      ]
    },
    "CapabilityID": {
      "type": "string",
      "enum": [
        "ouf.system.status"
      ]
    },
    "Owner": {
      "type": "string",
      "enum": [
        "mcp"
      ]
    },
    "OperationClass": {
      "type": "string",
      "enum": [
        "READ"
      ]
    },
    "Arguments": {
      "type": "object",
      "additionalProperties": false
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ServicePrincipalID",
        "PrincipalID",
        "TenantID",
        "ActorType",
        "AuthenticationContextRef"
      ],
      "properties": {
        "ServicePrincipalID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        },
        "PrincipalID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        },
        "TenantID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        },
        "ActorType": {
          "enum": [
            "HUMAN"
          ]
        },
        "AuthenticationContextRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        }
      }
    },
    "AuthorizationDecisionRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[ -~]+$"
    },
    "CorrelationID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[ -~]+$"
    },
    "IdempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[ -~]+$"
    },
    "AttemptID": {
      "type": "string",
      "format": "uuid"
    },
    "RequestHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "MaxResultBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    }
  }
}
