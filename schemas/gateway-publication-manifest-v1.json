{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouf.trieste.it/contracts/gateway/gateway-publication-manifest-v1.json",
  "title": "OUF Gateway Publication Manifest v1",
  "type": "object",
  "required": ["publicationId", "environment", "sourceRevisionRef", "artifactSetHash", "status", "createdAt"],
  "properties": {
    "publicationId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "environment": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "sourceRevisionRef": {"type": "string", "minLength": 1},
    "artifactSetHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"type": "string", "enum": ["VALIDATING", "COMPILED", "APPLYING", "VERIFIED", "ACTIVE", "FAILED", "ROLLED_BACK"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "activatedAt": {"type": ["string", "null"], "format": "date-time"},
    "verification": {"type": ["object", "null"]},
    "previousActivePublicationId": {"type": ["string", "null"]},
    "controlPlaneRevision": {"type": ["string", "null"]},
    "inputHashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  },
  "additionalProperties": false
}
