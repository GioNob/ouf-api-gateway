                          "properties": {
                            "component": {
                              "type": "string",
                              "pattern": "^[a-z][A-Za-z0-9]{0,63}$"
                            },
                            "items": {
                              "type": "array",
                              "items": {
                                "oneOf": [
                                  {
                                    "$ref": "#/properties/Arguments/$defs/fieldItem"
                                  },
                                  {
                                    "$ref": "#/properties/Arguments/$defs/constructorItem"
                                  },
                                  {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                      "structured": {
                                        "$ref": "#/properties/Arguments/$defs/structured2"
                                      }
                                    },
                                    "required": [
                                      "structured"
                                    ]
                                  }
                                ]
                              }
                            }
                          },
                          "required": [
                            "component",
                            "items"
                          ]
                        }
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 32,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "kind",
                  "targetPropertyIri",
                  "dataAccessLabel",
                  "typeRef",
                  "components"
                ]
              }
            ]
          },
          "minItems": 0,
          "maxItems": 1024,
          "description": "Use INCLUDE fields from this file. Build MANY with ordered items or LIST_SPLIT_V1. Onboarding checks component cardinality, output types and the limit of 256 leaves. New preparations require ACTIVE DATATYPE pins at every level. Published bundles may resolve ACTIVE, DEPRECATED or RETIRED pins. Concept membership requires a pinned CONCEPT of the vocabulary or a pinned value map targeting it."
        },
        "uuid": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "unitRef": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^(table|sheet|layer|collection):(0|[1-9][0-9]{0,3})$"
        },
        "unitProfileRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profileId",
            "profileVersion",
            "unitRef",
            "schemaHash"
          ],
          "properties": {
            "profileId": {
              "$ref": "#/properties/Arguments/$defs/uuid"
            },
            "profileVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "unitRef": {
              "$ref": "#/properties/Arguments/$defs/unitRef"
            },
            "schemaHash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "changes"
          ]
        },
        "oneOf": [
          {
            "required": [
              "assetRef"
            ]
          },
          {
            "required": [
              "unitProfileRef"
            ]
          }
        ]
      },
      "else": {
        "anyOf": [
          {
            "required": [
              "changes"
            ]
          },
          {
            "required": [
              "compositions"
            ]
          }
        ],
        "not": {
          "required": [
            "newColumns"
          ]
        }
      },
      "properties": {
        "compositions": {
          "$ref": "#/properties/Arguments/$defs/compositions"
        },
        "sourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
        },
        "parentVersionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}(?![\\s\\S])"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "configurationHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "commandKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "publicationEffect": {
          "const": "NEW_PUBLICATION_MAY_START_ACQUISITION"
        },
        "assetRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assetId",
            "profileId"
          ],
          "properties": {
            "assetId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$"
            },
            "profileId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$"
            }
          }
        },
        "newColumns": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "column",
              "decision"
            ],
            "if": {
              "properties": {
                "decision": {
                  "const": "MAP"
                }
              }
            },
            "then": {
              "required": [
                "mapping"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "mapping"
                ]
              }
            },
            "properties": {
              "column": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "enum": [
                  "EXCLUDE",
                  "MAP"
                ]
              },
              "mapping": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "propertyIri",
                  "transform",
                  "reconciliation"
                ],
                "allOf": [
                  {
                    "$ref": "#/properties/Arguments/$defs/fieldReaderParams"
                  }
                ],
                "properties": {
                  "propertyIri": {
                    "type": "string",
                    "format": "iri",
                    "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
                  },
                  "transform": {
                    "$ref": "#/properties/Arguments/$defs/reader"
                  },
                  "transformParams": {
                    "$ref": "#/properties/Arguments/$defs/transformParams"
                  },
                  "reconciliation": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "policyRef",
                      "cardinality",
                      "normalizerRef",
                      "normalizerVersion",
                      "validity"
                    ],
                    "properties": {
                      "policyRef": {
                        "const": "urn:ouf:policy:linked-object-property-reconciliation:v1"
                      },
                      "cardinality": {
                        "enum": [
                          "SINGLE",
                          "MULTI"
                        ]
                      },
                      "normalizerRef": {
                        "enum": [
                          "EXACT_TYPED",
                          "NFC_TRIM"
                        ]
                      },
                      "normalizerVersion": {
                        "const": 1
                      },
                      "validity": {
                        "enum": [
                          "UNBOUNDED",
                          "SOURCE_INTERVAL"
                        ]
                      },
                      "revisionField": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                      },
                      "deletionField": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                      }
                    }
                  },
                  "accessLabel": {
                    "enum": [
                      "OPEN",
                      "ANONYMOUS",
                      "PERSONAL",
                      "SENSITIVE",
                      "RESTRICTED"
                    ]
                  },
                  "authorityOrder": {
                    "type": "array",
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "comparison": {
                    "type": "object",
                    "description": "Required when the parent uses governedIdentity.",
                    "additionalProperties": false,
                    "required": [
                      "comparator",
                      "assertionRef"
                    ],
                    "properties": {
                      "comparator": {
                        "enum": [
                          "CONCEPT",
                          "TEXT_V1",
                          "DECIMAL_V1",
                          "JSON_V1"
                        ]
                      },
                      "assertionRef": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "propertyIri",
              "sourceField",
              "reconciliation"
            ],
            "properties": {
              "propertyIri": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "sourceField": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "reconciliation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "policyRef",
                  "cardinality",
                  "normalizerRef",
                  "normalizerVersion",
                  "validity"
                ],
                "properties": {
                  "policyRef": {
                    "const": "urn:ouf:policy:linked-object-property-reconciliation:v1"
                  },
                  "cardinality": {
                    "enum": [
                      "SINGLE",
                      "MULTI"
                    ]
                  },
                  "normalizerRef": {
                    "enum": [
                      "EXACT_TYPED",
                      "NFC_TRIM"
                    ]
                  },
                  "normalizerVersion": {
                    "const": 1
                  },
                  "validity": {
                    "enum": [
                      "UNBOUNDED",
                      "SOURCE_INTERVAL"
                    ]
                  },
                  "revisionField": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "deletionField": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                }
              }
            }
          }
        },
        "unitProfileRef": {
          "$ref": "#/properties/Arguments/$defs/unitProfileRef"
        }
      }
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ServicePrincipalID",
        "PrincipalID",
        "TenantID",
        "ActorType",
        "AuthenticationContextRef"
      ],
      "properties": {
        "ServicePrincipalID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        },
        "PrincipalID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        },
        "TenantID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        },
        "ActorType": {
          "enum": [
            "HUMAN"
          ]
        },
        "AuthenticationContextRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        }
      }
    },
    "AuthorizationDecisionRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[ -~]+$"
    },
    "CorrelationID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[ -~]+$"
    },
    "IdempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "AttemptID": {
      "type": "string",
      "format": "uuid"
    },
    "RequestHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "MaxResultBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    }
  },
  "$id": "urn:ouf:gateway:dispatch:source.onboarding.revision.prepare"
}
