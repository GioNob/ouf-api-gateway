{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouf.trieste.it/schemas/source-api-binding-registry-v1.json",
  "title": "OUF Gateway source API binding registry v1",
  "description": "Private installation registry of the southbound source API bindings (ouf.source-api.v1 section 2.1). Only this schema and fictitious examples live in the repository (D-058). The adapter enforces the same closed shape in code and applies stricter semantic checks: valid CIDR, unique bindingRef, no workload:// credential until an identity provider exists.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "bindings"],
  "properties": {
    "schema": {"const": "ouf.source-api-binding-registry.v1"},
    "revision": {"type": "integer", "minimum": 1},
    "bindings": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/binding"}}
  },
  "$defs": {
    "referenceName": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindingRef", "title", "contract", "origin", "allowedNetworks", "credentialRef",
                   "tenants", "collections", "limits", "status"],
      "properties": {
        "bindingRef": {"type": "string", "pattern": "^gateway://sources/[a-z0-9][a-z0-9-]{0,62}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"},
        "contract": {"const": "ouf.vertical-source.v1"},
        "origin": {
          "type": "string",
          "maxLength": 270,
          "pattern": "^https://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*(:[1-9][0-9]{0,4})?$"
        },
        "allowedNetworks": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 49, "pattern": "^[0-9a-f.:]+/[0-9]{1,3}$"}
        },
        "credentialRef": {"type": "string", "pattern": "^(secret|workload)://[a-z0-9][a-z0-9-]{0,62}$"},
        "trustRef": {"type": "string", "pattern": "^trust://[a-z0-9][a-z0-9-]{0,62}$"},
        "tenants": {
          "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
        },
        "collections": {
          "oneOf": [
            {"type": "array", "const": ["*"]},
            {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
             "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$"}}
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxPageBytes", "timeout", "maxRequestsPerMinute", "maxConcurrency"],
          "properties": {
            "maxPageBytes": {"type": "integer", "minimum": 1024, "maximum": 50000000},
            "timeout": {"type": "string", "pattern": "^PT([1-9]|[1-5][0-9]|60)S$"},
            "maxRequestsPerMinute": {"type": "integer", "minimum": 1, "maximum": 6000},
            "maxConcurrency": {"type": "integer", "minimum": 1, "maximum": 16}
          }
        },
        "status": {"enum": ["ACTIVE", "INACTIVE"]}
      }
    }
  }
}
