{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "GatewayBindingRef",
    "CapabilityID",
    "Owner",
    "OperationClass",
    "Arguments",
    "Identity",
    "AuthorizationDecisionRef",
    "CorrelationID",
    "IdempotencyKey",
    "AttemptID",
    "RequestHash",
    "MaxResultBytes"
  ],
  "properties": {
    "GatewayBindingRef": {
      "const": "capability://ouf.onboarding.revision.read"
    },
    "CapabilityID": {
      "const": "ouf.onboarding.revision.read"
    },
    "Owner": {
      "const": "onboarding"
    },
    "OperationClass": {
      "const": "READ"
    },
    "Arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
        },
        "onboardingVersionId": {
          "type": "string",
          "format": "uuid"
        },
        "parentVersionId": {
          "type": "string",
          "format": "uuid"
        },
        "commandKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "oneOf": [
        {
          "required": [
            "onboardingVersionId"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "parentVersionId"
                ]
              },
              {
                "required": [
                  "commandKey"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "parentVersionId",
            "commandKey"
          ],
          "not": {
            "required": [
              "onboardingVersionId"
            ]
          }
        }
      ]
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ServicePrincipalID",
        "PrincipalID",
        "TenantID",
        "ActorType",
        "AuthenticationContextRef"
      ],
      "properties": {
        "ServicePrincipalID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        },
        "PrincipalID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        },
        "TenantID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        },
        "ActorType": {
          "enum": [
            "HUMAN"
          ]
        },
        "AuthenticationContextRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        }
      }
    },
    "AuthorizationDecisionRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[ -~]+$"
    },
    "CorrelationID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[ -~]+$"
    },
    "IdempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "AttemptID": {
      "type": "string",
      "format": "uuid"
    },
    "RequestHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "MaxResultBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    }
  }
}
