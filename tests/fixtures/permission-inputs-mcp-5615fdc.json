{
  "sourceRepository": "GioNob/ouf-mcp-server",
  "sourceCommit": "5615fdcad8cbcad9ff41ec3d0ad2ccbf9423c042",
  "schemas": {
    "authorization.permissions.read": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "externalRoleRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policyRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "view": {
          "type": "string",
          "enum": [
            "GRANTS",
            "ROLES"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "view"
          ],
          "properties": {
            "view": {
              "const": "ROLES"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "subjectId"
                ]
              },
              {
                "required": [
                  "externalRoleRef"
                ]
              },
              {
                "required": [
                  "limit"
                ]
              },
              {
                "required": [
                  "after"
                ]
              },
              {
                "required": [
                  "policyRef"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "view": {
              "const": "GRANTS"
            }
          },
          "oneOf": [
            {
              "required": [
                "subjectId"
              ],
              "not": {
                "required": [
                  "externalRoleRef"
                ]
              }
            },
            {
              "required": [
                "externalRoleRef"
              ],
              "not": {
                "required": [
                  "subjectId"
                ]
              }
            }
          ]
        }
      ]
    },
    "authorization.permissions.propose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "reason"
      ],
      "properties": {
        "operation": {
          "enum": [
            "UPSERT",
            "REVOKE",
            "REPLACE_ROLES"
          ]
        },
        "grantId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_:.-]{1,128}$"
        },
        "grant": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "grantId",
            "capabilityId",
            "tenantId",
            "validFrom",
            "validUntil"
          ],
          "properties": {
            "grantId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "capabilityId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "tenantId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "subjectId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256
            },
            "servicePrincipalId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256
            },
            "organizationId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256
            },
            "validFrom": {
              "type": "string",
              "format": "date-time"
            },
            "validUntil": {
              "type": "string",
              "format": "date-time"
            },
            "constraints": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "effect": {
                  "enum": [
                    "ALLOW",
                    "DENY"
                  ]
                },
                "externalRoleRef": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 128
                },
                "resourceType": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 128
                },
                "resourceId": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 256
                },
                "resourceAttributes": {
                  "type": "object",
                  "maxProperties": 32,
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                },
                "allowedDataLabels": {
                  "type": "array",
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "allowedDetailLevels": {
                  "type": "array",
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "requiredAcr": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 128
                },
                "requiredAmr": {
                  "type": "array",
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "maxAuthenticationAgeSeconds": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 86400
                }
              }
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "roleCatalogue": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuer",
            "roles",
            "assignments"
          ],
          "properties": {
            "issuer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "roles": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "roleId",
                  "displayName",
                  "permissions"
                ],
                "properties": {
                  "roleId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]{1,80}$"
                  },
                  "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "permissions": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "capabilityId"
                      ],
                      "properties": {
                        "capabilityId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "constraints": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "effect": {
                              "enum": [
                                "ALLOW",
                                "DENY"
                              ]
                            },
                            "externalRoleRef": {
                              "type": "null"
                            },
                            "resourceType": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "maxLength": 128
                            },
                            "resourceId": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "maxLength": 256
                            },
                            "resourceAttributes": {
                              "type": "object",
                              "maxProperties": 32,
                              "additionalProperties": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 512
                              }
                            },
                            "allowedDataLabels": {
                              "type": "array",
                              "maxItems": 32,
                              "uniqueItems": true,
                              "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                              }
                            },
                            "allowedDetailLevels": {
                              "type": "array",
                              "maxItems": 16,
                              "uniqueItems": true,
                              "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                              }
                            },
                            "requiredAcr": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "maxLength": 128
                            },
                            "requiredAmr": {
                              "type": "array",
                              "maxItems": 32,
                              "uniqueItems": true,
                              "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                              }
                            },
                            "maxAuthenticationAgeSeconds": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 1,
                              "maximum": 86400
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "assignments": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "assignmentId",
                  "roleId",
                  "validFrom",
                  "validUntil"
                ],
                "properties": {
                  "assignmentId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]{1,80}$"
                  },
                  "roleId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]{1,80}$"
                  },
                  "subjectId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[!-~]{1,255}$"
                  },
                  "externalRoleRef": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[A-Za-z0-9_:./-]{1,128}$"
                  },
                  "validFrom": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "validUntil": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "subjectId"
                    ],
                    "properties": {
                      "subjectId": {
                        "type": "string"
                      },
                      "externalRoleRef": {
                        "type": "null"
                      }
                    }
                  },
                  {
                    "required": [
                      "externalRoleRef"
                    ],
                    "properties": {
                      "externalRoleRef": {
                        "type": "string"
                      },
                      "subjectId": {
                        "type": "null"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "grantId"
          ],
          "properties": {
            "operation": {
              "enum": [
                "UPSERT",
                "REVOKE"
              ]
            }
          },
          "not": {
            "required": [
              "roleCatalogue"
            ]
          }
        },
        {
          "required": [
            "roleCatalogue"
          ],
          "properties": {
            "operation": {
              "const": "REPLACE_ROLES"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "grantId"
                ]
              },
              {
                "required": [
                  "grant"
                ]
              }
            ]
          }
        }
      ]
    },
    "authorization.proposal.read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposalId"
      ],
      "properties": {
        "proposalId": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}

