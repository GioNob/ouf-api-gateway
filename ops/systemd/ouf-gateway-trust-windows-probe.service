[Unit]
Description=OUF Gateway trust policy windows probe
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=10001
WorkingDirectory=/opt/ouf/gateway
StateDirectory=ouf-gateway-operations
StateDirectoryMode=0750
UMask=0027
ExecStart=/usr/bin/python3 -m tools.gateway_operational_collector trust-windows --store /var/lib/ouf-gateway-operations/gateway-operations.sqlite --status /var/lib/ouf-trust-windows/status.json
SuccessExitStatus=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/ouf/gateway -/var/lib/ouf-trust-windows
ReadWritePaths=/var/lib/ouf-gateway-operations
