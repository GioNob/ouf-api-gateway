      },
      "plugins": {
        "request-id": {
          "header_name": "X-Correlation-ID",
          "include_in_response": true,
          "algorithm": "uuid"
        },
        "limit-count": {
          "count": 100,
          "time_window": 60,
          "rejected_code": 429
        },
        "proxy-rewrite": {
          "uri": "/api/internal/v1/ingestion/operations/status"
        }
      },
      "x-ouf-policy": {
        "identity": "M2M",
        "allowedServiceIdentities": [
